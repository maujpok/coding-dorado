# Configuración de la app. Copia este archivo a .env, completa los valores y
# ejecuta con --dart-define-from-file=.env (flutter run, flutter build y
# flutter test). El .env no se versiona; las URLs viven solo ahí.

# Obligatoria. URL base del API público de precios de El Dorado: la app pide
# {ELDORADO_API_URL}/prices. Ver API_RESEARCH.md.
ELDORADO_API_URL=

# Obligatoria. URL base del API de CriptoYa: la app pide
# {CRIPTOYA_API_URL}/{coin}/{fiat}/{volumen}. Ver API_RESEARCH.md.
CRIPTOYA_API_URL=

# Opcional. Fuente de la pestaña El Dorado: prices (precio indicativo, por
# defecto) u orderbook (API de órdenes, necesita API_URL).
ELDORADO_SOURCE=prices

# Opcional. URL completa del endpoint orderbook/public/recommendations. Solo se
# usa con ELDORADO_SOURCE=orderbook; vacía, la pestaña vuelve a /prices.
API_URL=
